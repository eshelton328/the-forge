(text "Switched battery measurement — protected battery node to ADC1 / GPIO2" (at 20.32 106.68 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "c16d05d3-4199-4dd5-8101-ba15bf2b133a"))
(text "GPIO12 HIGH enables measurement; wait 10 ms, read calibrated ADC, then drive LOW.\nScale = 4.3; 33k / 10k, 0.1%; 100 nF filter, time constant 0.77 ms.\nDesigned measurement range 0–6 V; battery chemistry and percentage thresholds remain firmware settings." (at 20.32 114.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "00192d2b-f2c9-4a33-9f32-f9a8bdb73346"))
